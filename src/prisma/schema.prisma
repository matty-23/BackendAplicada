generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String             @db.VarChar(100)
  apellido          String             @db.VarChar(100)
  correo            String             @unique @db.VarChar(255)
  contrasena        String
  departamento      String             @db.VarChar(100)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rol               Int                @default(1)
  logs              AuditoriaLog[]
  comentarios       Comentario[]
  participantes     Participante[]
  planillas         PlanillaHoras[]
  solicitudes       Solicitud[]
  ocurrenciaEventos OcurrenciaEvento[]

  @@map("usuarios")
}

model Evento {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo       String                      @db.VarChar(255)
  estado       String                      @default("pendiente") @db.VarChar(50)
  categoria    String                      @db.VarChar(100)
  createdAt    DateTime?                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ocurrencias  OcurrenciaEvento[]
  auditoriaEq  AuditoriaEquiposPorEvento[]
  auditoriaSol AuditoriaSolicitudAEvento[]
  comentarios  Comentario[]

  @@map("eventos")
}

model OcurrenciaEvento {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idEvento          String         @map("id_evento") @db.Uuid
  fechaInicio       DateTime       @map("fecha_inicio") @db.Timestamptz(6)
  fechaFinalizacion DateTime       @map("fecha_finalizacion") @db.Timestamptz(6)
  lugar             String         @db.VarChar(255)
  cantidadPersonas  Int            @map("cantidad_personas")
  idEncargado       String?        @map("id_encargado") @db.Uuid
  equipamiento      String?
  evento            Evento         @relation(fields: [idEvento], references: [id], onDelete: Cascade)
  usuarioEncargado  Usuario?       @relation(fields: [idEncargado], references: [id], onDelete: SetNull)
  participantes     Participante[]

  @@map("ocurrencias_evento")
}

model Solicitud {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idUsuarioSolicitante String                      @map("id_usuario_solicitante") @db.Uuid
  personaEncargada     String?                     @map("persona_encargada") @db.VarChar(150)
  cantidadPersona      Int?                        @map("cantidad_persona")
  lugar                String?                     @db.VarChar(255)
  fechaInicio          DateTime                    @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin             DateTime                    @map("fecha_fin") @db.Timestamptz(6)
  tipoEvento           String?                     @map("tipo_evento") @db.VarChar(100)
  estado               String?                     @default("pendiente") @db.VarChar(50)
  createdAt            DateTime?                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditoriaSol         AuditoriaSolicitudAEvento[]
  usuario              Usuario                     @relation(fields: [idUsuarioSolicitante], references: [id], onDelete: Cascade)

  @@map("solicitudes")
}

model PlanillaHoras {
  id            BigInt    @id @default(autoincrement())
  usuarioId     String    @map("usuario_id") @db.Uuid
  cantidadHoras Decimal   @map("cantidad_horas") @db.Decimal(5, 2)
  estado        String?   @default("registrado") @db.VarChar(50)
  fechaEvento   DateTime  @map("fecha_evento") @db.Timestamptz(6)
  fechaHoras    DateTime? @default(now()) @map("fecha_horas") @db.Timestamptz(6)
  mes           DateTime  @db.Date
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("planilla_horas")
}

model Participante {
  usuarioId    String @map("usuario_id") @db.Uuid
  idOcurrencia String @map("id_ocurrencia") @db.Uuid

  ocurrencia OcurrenciaEvento @relation(fields: [idOcurrencia], references: [id], onDelete: Cascade)
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // La clave primaria compuesta evita que un usuario se anote 2 veces a la misma fecha
  @@id([usuarioId, idOcurrencia])
  @@map("participante")
}

model Comentario {
  id        BigInt    @id @default(autoincrement())
  idUsuario String    @map("id_usuario") @db.Uuid
  idEvento  String    @map("id_evento") @db.Uuid
  contenido String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  evento    Evento    @relation(fields: [idEvento], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

model Inventario {
  id        BigInt    @id @default(autoincrement())
  nombre    String    @db.VarChar(150)
  cantidad  Int?      @default(0)
  categoria String?   @db.VarChar(100)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  equipos   Equipo[]

  @@map("inventario")
}

model Equipo {
  id             BigInt                      @id @default(autoincrement())
  idInventario   BigInt?                     @map("id_inventario")
  fechaIngreso   DateTime?                   @default(now()) @map("fecha_ingreso") @db.Date
  estado         String?                     @default("disponible") @db.VarChar(50)
  idCategoria    BigInt?                     @map("id_categoria")
  codigo         String                      @unique @db.VarChar(100)
  createdAt      DateTime?                   @default(now()) @map("created_at") @db.Timestamptz(6)
  atributos      AtributoValor[]
  auditoriaEvent AuditoriaEquiposPorEvento[]
  inventario     Inventario?                 @relation(fields: [idInventario], references: [id])

  @@map("equipo")
}

model PlantillaEquipo {
  id        BigInt              @id @default(autoincrement())
  categoria String              @db.VarChar(100)
  createdAt DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  atributos AtributoPlantilla[]

  @@map("plantilla_equipo")
}

model AtributoPlantilla {
  idAtributo     BigInt          @id @default(autoincrement()) @map("id_atributo")
  idPlantilla    BigInt          @map("id_plantilla")
  nombreAtributo String          @map("nombre_atributo") @db.VarChar(100)
  plantilla      PlantillaEquipo @relation(fields: [idPlantilla], references: [id], onDelete: Cascade)
  valores        AtributoValor[]

  @@map("atributo_plantilla")
}

model AtributoValor {
  id         BigInt            @id @default(autoincrement())
  idAtributo BigInt            @map("id_atributo")
  idEquipo   BigInt?           @map("id_equipo")
  valor      String
  atributo   AtributoPlantilla @relation(fields: [idAtributo], references: [idAtributo], onDelete: Cascade)
  equipo     Equipo?           @relation(fields: [idEquipo], references: [id], onDelete: Cascade)

  @@map("atributo_valor")
}

model AuditoriaLog {
  id        BigInt    @id @default(autoincrement())
  idUsuario String?   @map("id_usuario") @db.Uuid
  accion    String?   @db.VarChar(255)
  fechaLog  DateTime? @default(now()) @map("fecha_log") @db.Timestamptz(6)
  usuario   Usuario?  @relation(fields: [idUsuario], references: [id])

  @@map("auditoria_log")
}

model AuditoriaReportes {
  id           BigInt    @id @default(autoincrement())
  tipo         String?   @db.VarChar(100)
  estadisticas Json?
  fecha        DateTime? @default(now()) @db.Timestamptz(6)
  nombre       String?   @db.VarChar(150)
  contenido    String?

  @@map("auditoria_reportes")
}

model AuditoriaSolicitudAEvento {
  id             BigInt     @id @default(autoincrement())
  idSolicitud    String?    @map("id_solicitud") @db.Uuid
  idEvento       String?    @map("id_evento") @db.Uuid
  fechaSolicitud DateTime?  @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  evento         Evento?    @relation(fields: [idEvento], references: [id])
  solicitud      Solicitud? @relation(fields: [idSolicitud], references: [id])

  @@map("auditoria_solicitud_a_evento")
}

model AuditoriaEquiposPorEvento {
  id             BigInt    @id @default(autoincrement())
  idEvento       String?   @map("id_evento") @db.Uuid
  idEquipo       BigInt?   @map("id_equipo")
  fechaAuditoria DateTime? @default(now()) @map("fecha_auditoria") @db.Timestamptz(6)
  equipo         Equipo?   @relation(fields: [idEquipo], references: [id], onDelete: Cascade)
  evento         Evento?   @relation(fields: [idEvento], references: [id], onDelete: Cascade)

  @@map("auditoria_equipos_por_evento")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime
  updatedAt DateTime

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
